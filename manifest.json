{
  "manifest_version": 3,
  "name": "CultureX Quick Search",
  "version": "1.4.1",
  "description": "Select Instagram creators anywhere, press your hotkey, open them in Influenzer Search & Analysis, unlock audiences, and build an exportable creator sheet.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabGroups",
    "contextMenus",
    "offscreen",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://app.influenzer.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CultureX Quick Search",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-hotkeys.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://app.influenzer.io/*"
      ],
      "js": [
        "content-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.influenzer.io/*"
      ],
      "js": [
        "profile-parse.js",
        "content-influenzer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "search-creators": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Search selected Instagram creators in Influenzer"
    },
    "unlock-audience": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Search + unlock the Audience tab (uses credits)"
    }
  }
}